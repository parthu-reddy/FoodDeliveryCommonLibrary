<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>common-library</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>common-core</artifactId>
    <packaging>jar</packaging>

    <!-- Constants, enums, DTOs, domain events, plain exception types and Jackson wiring.
         Deliberately the module with nothing heavy in it: 16 services use `constants` and 14 use
         `enums`, and none of them should pay for JPA, Kafka or a servlet container to do so. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- PageResponseDto wraps Spring Data's Page. spring-data-commons alone, NOT
             spring-boot-starter-data-jpa: core must not drag Hibernate (11 MB) into every service
             that only wanted an enum. -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
        </dependency>
        <dependency>
            <!-- The jakarta variant, matching what springdoc actually puts on the classpath today
                 (swagger-annotations-jakarta 2.2.21, verified in a built service jar). The non-jakarta
                 artifact of the same name exists and compiles, but would sit beside the real one at
                 runtime. -->
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.21</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Test scope only: a module's own unit tests. Not inherited by consumers. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>cz.habarta.typescript-generator</groupId>
                <artifactId>typescript-generator-maven-plugin</artifactId>
                <version>3.2.1263</version>
                <executions>
                    <execution>
                        <id>generate</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>process-classes</phase>
                    </execution>
                </executions>
                <configuration>
                    <jsonLibrary>jackson2</jsonLibrary>
                    <classPatterns>
                        <pattern>com.fooddelivery.common.enums.**</pattern>
                    </classPatterns>
                    <!-- One directory deeper than before the split: this module sits inside
                         CommonLibrary/, so the path back out to the workspace gains a level. -->
                    <outputFile>../../FoodDeliveryAppUI/src/types/backend-enums.ts</outputFile>
                    <outputKind>module</outputKind>
                    <outputFileType>implementationFile</outputFileType>
                    <mapEnum>asEnum</mapEnum>
                    <nonConstEnums>true</nonConstEnums>
                    <!-- The default header comment embeds the generation timestamp, so every build
                         of this module rewrote a tracked file in FoodDeliveryAppUI with no semantic
                         change: the UI working tree was never clean after a backend build, real
                         enum changes were buried in timestamp noise, and no "generated code is in
                         sync" check could be written because it would flap. -->
                    <noFileComment>true</noFileComment>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
