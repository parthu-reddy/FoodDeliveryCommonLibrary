<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fooddelivery</groupId>
        <artifactId>food-delivery-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <!-- Empty relativePath: resolve from the artifact repository, not a sibling
             directory. This repo must build on its own, without the workspace. -->
        <relativePath/>
    </parent>

    <groupId>com.fooddelivery</groupId>
    <artifactId>common-library</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>common-library</name>
    <description>Shared models, utilities, and services for Food Delivery Microservices</description>

    <!--
      Aggregator only. This pom deliberately declares NO <dependencies>.

      Until 2026-09-12 it declared 32 at compile scope with no <dependencyManagement>, so every
      consuming service inherited all 32 transitively. Measured cost on ReviewsService: a 126 MB fat
      jar carrying 6.7 MB of AWS S3 SDK it never imports, because three services upload images.
      Compare food-delivery-parent, which has always done it the other way round: 39 managed, 1 real.

      Versions are not restated here. food-delivery-parent imports spring-cloud-dependencies,
      opentelemetry-bom and the AWS bom, and modules two levels down inherit those imports, so a
      module declares `spring-boot-starter-web` with no version exactly as this file used to.
    -->
    <modules>
        <module>common-core</module>
        <module>common-persistence</module>
        <module>common-messaging</module>
        <module>common-web</module>
        <module>common-storage</module>
        <module>common-test</module>
    </modules>

    <properties>
        <lombok.version>1.18.38</lombok.version>
        <java.version>17</java.version>
        <spring-cloud.version>2023.0.2</spring-cloud.version>
    </properties>

    <build>
        <plugins>
            <!-- Inherited by every module: they all compile lombok-annotated code. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <fork>true</fork>
                    <compilerArgs>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                        <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.jvm=ALL-UNNAMED</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true -Dspring.cloud.config.fail-fast=false</argLine>
                    <systemPropertyVariables>
                        <!-- Config Server is mandatory in production (I-34) but must not be
                             contacted from tests. This has to be a system property: the
                             configserver: import in application.yml is resolved before any
                             profile-specific YAML is read, so an override there is too late. -->
                        <spring.cloud.config.fail-fast>false</spring.cloud.config.fail-fast>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
      Publishing only. There is deliberately no <repositories> entry here to match it.

      GitHub Packages requires authentication even to read a public package, so a resolution
      repository in this pom would make every developer's build consult an authenticated remote for
      SNAPSHOT updates, and a machine without a token would start failing builds that work today.
      Resolution lives in a CI-only settings.xml instead; local builds keep resolving from ~/.m2.

      The <id> must match the <server><id> the workflow writes, or deploy fails with a 401 that
      reads like a permissions problem rather than a configuration one.
    -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages — parthu-reddy/FoodDeliveryCommonLibrary</name>
            <url>https://maven.pkg.github.com/parthu-reddy/FoodDeliveryCommonLibrary</url>
        </repository>
    </distributionManagement>

</project>
